# Giljo HQ Environment Configuration
# Copy this file to .env and update with your values
# NEVER commit .env to version control!

# =============================================================================
# PORT CONFIGURATION (v2.0 Unified Architecture)
# =============================================================================
# Main API Server Port (handles API + WebSocket + MCP tools)
GILJO_API_PORT=7272
GILJO_PORT=7272  # Alias for GILJO_API_PORT

# Frontend Development Server Port
GILJO_FRONTEND_PORT=6000
VITE_FRONTEND_PORT=6000

# PostgreSQL Database Port
POSTGRES_PORT=5432
DB_PORT=5432

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_TYPE=postgresql
DB_HOST=localhost
DB_NAME=giljo_mcp
DB_USER=postgres
DB_PASSWORD=your_password_here

# Alternative: Full database URL (overrides individual settings)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/giljo_mcp

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Deployment mode: LOCAL, LAN, or WAN
GILJO_MCP_MODE=LOCAL

# API Host (0.0.0.0 for network access, 127.0.0.1 for localhost only)
GILJO_API_HOST=127.0.0.1

# =============================================================================
# SECURITY
# =============================================================================
# API Key for authentication (required for LAN/WAN modes)
GILJO_MCP_API_KEY=

# Secret key for session management
GILJO_MCP_SECRET_KEY=

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# API URL for frontend (usually http://localhost:${GILJO_API_PORT})
VITE_API_URL=http://localhost:7272
# For HTTPS: VITE_API_URL=https://yourdomain.com:7272

# WebSocket URL (same as API in v2.0)
VITE_WS_URL=ws://localhost:7272
# For HTTPS: VITE_WS_URL=wss://yourdomain.com:7272

# App mode
VITE_APP_MODE=local

# API port for frontend
VITE_API_PORT=7272

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins or JSON array
CORS_ORIGINS=http://localhost:*
# For HTTPS: CORS_ORIGINS=https://localhost:*,https://127.0.0.1:*

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/giljo_mcp.log
DEBUG=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# BE-9148: retired the dead feature-flag/agent/session-timeout vars that had
# zero consumers (ENABLE_VISION_CHUNKING/AUTO_HANDOFF/DYNAMIC_DISCOVERY,
# MAX_AGENTS_PER_PROJECT, AGENT_CONTEXT_LIMIT, AGENT_HANDOFF_THRESHOLD,
# SESSION_TIMEOUT). BE-9138 additionally retired ENABLE_MULTI_TENANT and
# ENABLE_WEBSOCKET. Setting any of them in an existing .env is inert — nothing
# reads them.

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
MAX_CONCURRENT_SESSIONS=10
SESSION_CLEANUP_INTERVAL=300

# =============================================================================
# MESSAGE QUEUE CONFIGURATION
# =============================================================================
MAX_QUEUE_SIZE=1000
MESSAGE_BATCH_SIZE=10
MESSAGE_RETRY_ATTEMPTS=3
MESSAGE_RETRY_DELAY=1.0

# =============================================================================
# DOCKER BUILD CONFIGURATION
# =============================================================================
BUILD_TARGET=production

# =============================================================================
# ACTIVE PRODUCT (for MCP server context)
# =============================================================================
ACTIVE_PRODUCT="GiljoAI-MCP Coding Orchestrator"

# =============================================================================
# EDITION MODE (CE / Demo / SaaS)
# =============================================================================
# Controls which features are active. Not set = CE (default).
# GILJO_MODE=saas
# GILJO_MODE=demo

# =============================================================================
# SENDGRID (SaaS/Demo only)
# =============================================================================
# Required when GILJO_MODE=saas or demo for transactional email.
# SENDGRID_API_KEY=SG.your-api-key-here
# SENDGRID_FROM_EMAIL=noreply@giljo.ai

# =============================================================================
# SSL Configuration (optional - config.yaml is preferred)
# =============================================================================
# SSL_CERT_FILE=./certs/ssl_cert.pem
# SSL_KEY_FILE=./certs/ssl_key.pem

# =============================================================================
# E2E TEST CREDENTIALS (Playwright -- not committed)
# =============================================================================
# Required when running frontend/tests/e2e/ Playwright suite. The test files
# read these env vars to log in as a real test user. Never hardcode credentials
# in the test files themselves.
# TEST_USER=your-test-username
# TEST_PASSWORD=your-test-password

# =============================================================================
# POSTGRES SUPERUSER PASSWORD (admin scripts only -- not committed)
# =============================================================================
# Required when running admin scripts that operate as the postgres superuser:
# uninstall.py, scripts/reset_postgresql.py, reset.py, tests/helpers/test_db_helper.py,
# scripts/_historical/*. NOT used by the runtime application -- the app uses
# DB_PASSWORD with the giljo_user role provisioned by install.py.
# POSTGRES_SUPERUSER_PASSWORD=your-postgres-superuser-password
