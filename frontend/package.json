{
  "name": "giljo-mcp-frontend",
  "version": "2.10.0",
  "description": "Giljo HQ - Dashboard UI",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src/ --fix",
    "format": "prettier --write src/",
    "codegen:colors": "node scripts/generate-agent-colors.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@sentry/vite-plugin": "^11.8.0",
    "@sentry/vue": "^11.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "js-yaml": "^5.4.3",
    "lodash-es": "^4.18.1",
    "marked": "^18.1.1",
    "pinia": "^4.0.3",
    "sass-embedded": "^1.105.1",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.2.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=22.23.3",
    "npm": ">=8.19.4"
  }
}
