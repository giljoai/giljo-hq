    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.5"
  },
  "engines": {
    "node": ">=22.23.3",
    "npm": ">=8.19.4"
  }
