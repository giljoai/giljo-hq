    "@sentry/vue": "^11.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.21.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "js-yaml": "^5.5.0",
    "lodash-es": "^4.18.1",
    "marked": "^18.1.3",
    "pinia": "^4.1.0",
    "sass-embedded": "^1.107.0",
    "vite": "^8.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.3.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
