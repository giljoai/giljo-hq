        <!--v-if-->
      </div>
    </div><!-- Card 2 — Configuration command (only when key is available) -->
    <!--v-if-->
  </div><!-- Command card — sign-in path (no bearer). Key/manual paths show their command inside KeyFlow. -->
  <!--v-if-->
  <!-- STATUS HERO — waiting (amber pulse) → connected (green pop + advance) -->
  <div data-v-a2dec1b3="" class="status-hero status-hero--waiting" data-testid="status-hero"><span data-v-a2dec1b3="" class="hero-dot hero-dot--waiting" data-testid="hero-dot"></span>
    <div data-v-a2dec1b3="" class="hero-body"><span data-v-a2dec1b3="" class="hero-title">Waiting for Generic MCP client to connect…</span><span data-v-a2dec1b3="" class="hero-sub">The moment your tool connects, this flips green. Nothing to click.</span></div>
  </div><!-- Fallback links (per method matrix) + "I already configured this" -->
